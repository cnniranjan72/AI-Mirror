{
  "manifest_version": 3,
  "name": "AIMirror - Behavioral Tracker (Instagram + YouTube)",
  "version": "1.1.0",
  "description": "Track your Instagram Reels and YouTube watching behavior for transparency and self-awareness",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.youtube.com/*",
    "https://aimirror-backend-cu00.onrender.com/*",
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
