# Required — no fallback. Get a free Postgres+pgvector database at
# https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required — embeddings via Hugging Face's hosted Inference API (free tier).
# Get one at https://huggingface.co/settings/tokens (Read scope is enough).
HF_API_TOKEN=

# LLM verbalization layer — the ONLY place an LLM is used; it never
# reasons or decides, only turns already-decided facts into prose. This is
# the server-wide fallback; individual users can override it per-account
# from Settings → AI Provider (see app/api/settings.py), which takes
# priority over all of this when configured.
#   LLM_PROVIDER: "openai", "anthropic", "gemini", or "ollama"
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama (local) — requires the model pulled once: `ollama pull llama3.2`.
# Only reachable when the backend itself runs on the same machine as
# Ollama — a deployed backend can't reach your laptop.
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL_OLLAMA=llama3.2

# Signs auth tokens. Set your own random value before this backend is
# reachable by anyone besides you.
AUTH_SECRET=change-me-to-something-random

# Encrypts per-user AI provider API keys at rest (users.llm_api_key_encrypted).
# Set your own random value in any real deployment.
API_KEY_ENCRYPTION_SECRET=change-me-to-something-random

# Salts the one-way participant IDs in the researcher bulk export
# (GET /research/export) — keep distinct from AUTH_SECRET so either can be
# rotated independently.
RESEARCH_EXPORT_SALT=change-me-to-something-random

# Comma-separated list of allowed dashboard origins (browser CORS). Include
# your deployed frontend's real URL in production — do not use "*".
CORS_ORIGINS=http://localhost:5173

# Server
PORT=8000
LOG_LEVEL=INFO
