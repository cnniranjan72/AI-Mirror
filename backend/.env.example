# Required — no fallback. Get a free Postgres+pgvector database at
# https://console.neon.tech/
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM verbalization layer — the ONLY place an LLM is used; it never
# reasons or decides, only turns already-decided facts into prose.
#   LLM_PROVIDER: "ollama" (local, free), "openai", or "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local) — requires the model pulled once: `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL_OLLAMA=llama3.2

# Signs auth tokens (see SETUP.md "Known limitations"). Set your own
# random value before this backend is reachable by anyone besides you.
AUTH_SECRET=change-me-to-something-random

# Server
PORT=8000
LOG_LEVEL=INFO
