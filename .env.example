# ── AIMirror backend configuration ───────────────────────────────────────────
# Copy to `backend/.env` (or export in your shell) before running the backend.

# PostgreSQL + pgvector connection string (required — the app refuses to start
# without it). Neon example:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# LLM verbalization layer.
#   LLM_PROVIDER: "openai" (default) or "anthropic"
#   LLM_MODEL:    optional override; when unset each provider uses its own
#                 default (gpt-4o / claude-sonnet-5)
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
PORT=8000
LOG_LEVEL=INFO
