# ── AIMirror backend configuration ───────────────────────────────────────────
# Copy to `backend/.env` (or export in your shell) before running the backend.

# PostgreSQL + pgvector connection string (required — the app refuses to start
# without it). Neon example:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# LLM verbalization layer.
#   LLM_PROVIDER: "ollama" (local, free), "openai", or "anthropic"
#   LLM_MODEL:    optional override for openai/anthropic; when unset each uses
#                 its own default (gpt-4o / claude-sonnet-5)
#
# Local dev uses Ollama (no quota, no cost). To deploy, just switch
# LLM_PROVIDER to "openai" (or "anthropic") — no code change needed.
LLM_PROVIDER=ollama
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local) — requires `ollama serve` running and the model pulled
# (`ollama pull llama3.2`).
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL_OLLAMA=llama3.2

# Bound each LLM request; on error the pipeline falls back to deterministic text.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=0

# Server
PORT=8000
LOG_LEVEL=INFO
